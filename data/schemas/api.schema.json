{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect-framework.dev/schemas/api.schema.json",
  "title": "ApiRecord",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "owner",
    "domain",
    "lifecycleStatus",
    "namingCompliant",
    "reusable",
    "securityClassification",
    "costCenter",
    "description"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "owner": { "type": "string", "minLength": 1 },
    "domain": { "type": "string" },
    "lifecycleStatus": {
      "type": "string",
      "enum": ["Active", "Deprecated", "Retired", "Draft"]
    },
    "namingCompliant": { "type": "boolean" },
    "reusable": { "type": "boolean" },
    "securityClassification": {
      "type": "string",
      "enum": ["Public", "Internal", "Confidential", "Restricted"]
    },
    "costCenter": { "type": "string", "minLength": 1 },
    "description": { "type": "string" }
  },
  "additionalProperties": false
}
